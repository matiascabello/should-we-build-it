# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real keys.

# Required
OPENAI_API_KEY=
SERPER_API_KEY=

# Optional — enables LangSmith tracing (every LLM/tool call becomes a
# traced run). Leave blank to run without tracing.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=should-we-build-it
